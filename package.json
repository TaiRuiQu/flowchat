{
  "name": "flowchat",
  "version": "0.3.5",
  "private": true,
  "author": "Tairui Qu",
  "license": "MIT",
  "homepage": "https://github.com/TaiRuiQu/flowchat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TaiRuiQu/flowchat.git"
  },
  "bugs": {
    "url": "https://github.com/TaiRuiQu/flowchat/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "A thoughtful space for conversations that branch.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite preview",
    "icons": "node tools/build-icons.mjs",
    "test": "vitest run",
    "test:ui": "node tools/test-electron.mjs && node tools/test-features.mjs && node tools/test-markdown-editor.mjs && node tools/test-fonts.mjs",
    "test:layout": "node tools/test-layout.mjs",
    "format": "prettier --write .github docs README.md electron shared src/renderer tests/electron tools/*.mjs *.json *.ts",
    "format:check": "prettier --check .github docs README.md electron shared src/renderer tests/electron tools/*.mjs *.json *.ts",
    "package": "npm run build && electron-builder --win dir --x64 --publish never",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@opencode/client": "2.2.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vditor": "4.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "45.3.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "5.0.0",
    "mdast-util-from-markdown": "^2.1.0",
    "micromark-util-types": "^2.0.3",
    "playwright": "^1.56.1",
    "prettier": "3.6.2",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "7.2.2",
    "vitest": "4.0.8"
  },
  "overrides": {
    "katex": "$katex"
  },
  "build": {
    "appId": "com.flowchat.desktop",
    "productName": "FlowChat",
    "directories": {
      "output": ".artifacts/electron"
    },
    "files": [
      "dist-electron/**",
      "dist/**",
      "assets/**",
      "LICENSE",
      "THIRD_PARTY.md",
      "package.json"
    ],
    "win": {
      "icon": "assets/flowchat.ico",
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "FlowChat-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true
  }
}
